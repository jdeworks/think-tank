# ─────────────────────────────────────────────────────────────
#  Think Tank — Local Configuration
#  Copy to .env and edit:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Mode: "agent" (use a coding agent CLI) or "api" (call Anthropic API directly)
THINK_TANK_MODE=agent

# Agent to use (when mode=agent):
#   claude  — Claude Code      (claude -p "...")
#   cursor  — Cursor           (cursor --agent "...")
#   codex   — OpenAI Codex CLI (codex "...")
#   aider   — Aider            (aider --message "...")
#   custom  — Your own command (set THINK_TANK_AGENT_CMD below)
THINK_TANK_AGENT=claude

# Custom agent command — only used when THINK_TANK_AGENT=custom
# The prompt is appended as the last argument.
# Example: THINK_TANK_AGENT_CMD="my-agent --prompt"
# THINK_TANK_AGENT_CMD=

# Anthropic API key — only needed when THINK_TANK_MODE=api
# ANTHROPIC_API_KEY=sk-ant-...

# Model (api mode only): claude-sonnet-4-6 | claude-haiku-4-5-20251001 | claude-opus-4-6
THINK_TANK_MODEL=claude-sonnet-4-6

# Default personality: friendly | researcher | critical | architect | budget
THINK_TANK_PERSONALITY=friendly

# Output directory for generated plans
THINK_TANK_OUTPUT=think-tank-output
